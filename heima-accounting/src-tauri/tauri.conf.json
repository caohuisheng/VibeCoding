{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-spec/refs/heads/main/tauri-conf.schema.json",
  "productName": "heima-accounting",
  "version": "1.0.0",
  "identifier": "com.heima.accounting",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "heima-accounting",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "portable"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": ""
    }
  }
}
